# Banking bot configuration — copy to .env and fill in.

# ── Discord (required) ────────────────────────────────────────────────────────
# The bank bot's OWN Discord application token (separate from Restocker's bot).
BANK_DISCORD_TOKEN=
# Optional: a guild ID to sync slash commands instantly to one server (dev).
# Leave empty for global sync (can take up to ~1h to appear).
BANK_GUILD_ID=
# Channel that gets a "🎫 New account — pending review" ticket (with ✅/❌
# reactions) every time someone opens a brand-new bank account, for Lead
# Bankers to review. Leave empty to disable.
NEW_ACCOUNT_CHANNEL_ID=1518146924270587934
# Loan requests are posted here with Approve/Deny buttons (when
# LOAN_REQUIRE_APPROVAL=1). Leave empty to disable the post — requests are
# still decidable via /admin loans.
LOAN_PROPOSALS_CHANNEL_ID=1515925123159556111
# Short audit-trail line posted here for deposit/withdraw/transfer/loan
# repay/bond buy+redeem/invest buy+sell. Leave empty to disable.
BOT_LOG_CHANNEL_ID=1515925132051349617

# ── Restocker connection (required) ──────────────────────────────────────────
# Base URL of the Restocker web server (the Cloudflare-tunnel/public URL).
# No trailing slash. e.g. https://restocker.example.com
RESTOCKER_API_URL=
# Must EXACTLY match BANK_API_TOKEN in Restocker's .env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESTOCKER_BANK_TOKEN=

# ── Staff (who can use /admin) ───────────────────────────────────────────────
# Comma-separated Discord ROLE IDs — anyone holding one is a Lead Banker.
LEAD_BANKER_ROLE_IDS=
# Comma-separated Discord USER IDs, for individuals without a staff role.
BANK_ADMIN_USER_IDS=
# If BOTH are empty, /admin falls back to server Administrators only.

# ── Lending (optional) ───────────────────────────────────────────────────────
# 1 = /loan request creates a PENDING request that a Lead Banker must approve
# before any coins move. 0 = the old behaviour, instant disbursement.
LOAN_REQUIRE_APPROVAL=1
# How many un-decided requests one member may have queued at once.
MAX_PENDING_LOANS=1
# Credit limit = BASE + CREDIT_PER_REPAID_LOAN x (loans fully repaid)
#                     − CREDIT_LATE_PENALTY x (loans that ever went overdue),
# clamped to [0, MAX_LOAN]. Any loan written off drops the limit to 0 until a
# Lead Banker sets an override with /admin creditlimit.
BASE_CREDIT_LIMIT=10000
CREDIT_PER_REPAID_LOAN=5000
CREDIT_LATE_PENALTY=5000

# ── Collections (optional) ───────────────────────────────────────────────────
# Announce a loan in the log channel the first time it goes past due.
OVERDUE_ANNOUNCE=1
# Seize a defaulter's SAVINGS against their overdue debt. The wallet is never
# touched — the bank only takes what it's already holding.
COLLECT_FROM_SAVINGS=1
# Days past the due date before seizure starts.
COLLECT_GRACE_DAYS=3
# Apply a maturing bond's payout to overdue debt before the rest hits the wallet.
GARNISH_BOND_PAYOUTS=1

# ── Economy knobs (optional) ─────────────────────────────────────────────────
SAVINGS_APR=0.05          # annual savings interest (5%), compounded daily
LOAN_APR=0.18             # annual loan interest (18%)
LOAN_OVERDUE_EXTRA_APR=0.18  # extra APR added while a loan is past due
MAX_LOAN=100000           # hard cap on total outstanding debt per user
DEFAULT_LOAN_DAYS=30      # default loan term

# Fixed-term bonds: comma-separated term_days:annual_rate pairs.
# Longer terms should pay more. Payout = principal * (1 + apr * days/365),
# fixed at purchase and paid at maturity.
BOND_TERMS=7:0.06,30:0.09,90:0.14
# Extra fraction of PRINCIPAL forfeited on early redemption (interest is always
# forfeited when redeeming early). 0.0 = return full principal early.
BOND_EARLY_PENALTY_PCT=0.0

# ── Storage (optional) ───────────────────────────────────────────────────────
# Where the bank's own SQLite DB lives. Defaults to ./bank.db next to the code.
BANK_DB_PATH=
